"    status: Literal[\"Pending\", \"In Progress\", \"Completed\"]\n","\n","\n","class TaskPlan(BaseModel):\n","    model_config = ConfigDict(extra=\"forbid\", strict=True)\n","\n","    project_name: str\n","    tasks: List[Task]\n","\n","\n","# STEP 2: Validate JSON data\n","\n","def validate_json(raw_json: str) -> TaskPlan:\n","    \"\"\"Reject invalid JSON or incorrect field types.\"\"\"\n","    return TaskPlan.model_validate_json(raw_json)\n","\n","\n","# STEP 3: Ask the AI model for structured JSON\n","\n","def generate_json(notes: str, repair_message: str = \"\") -> str:\n","\n","    prompt = f\"\"\"\n","    Convert the following notes into a task plan.\n","\n","    Return data matching the supplied JSON schema.\n","\n","    Rules:\n","    - Include every actionable task.\n","    - Do not invent deadlines or owners.\n","    - Use null when information is missing.\n","    - Status must be Pending unless another status\n","      is explicitly mentioned.\n","\n","    Notes:\n","    {notes}\n","\n","    {repair_message}\n","    \"\"\"\n","\n","    response = client.responses.create(\n","        model=MODEL,\n","        input=prompt,\n","        text={\n","            \"format\": {\n","                \"type\": \"json_schema\",\n","                \"name\": \"task_plan\",\n","                \"strict\": True,\n","                \"schema\": TaskPlan.model_json_schema()\n","            }\n","        }\n","    )\n","\n","    if response.status != \"completed\":\n","        raise ValueError(\n","            f\"Model response incomplete: {response.status}\"\n","        )\n","\n","    if not response.output_text:\n","        raise ValueError(\"Model returned empty output\")\n","\n","    return response.output_text\n","\n","\n","# STEP 4: Retry or repair invalid JSON\n","\n","def get_valid_data(notes: str) -> TaskPlan:\n","\n","    repair_message = \"\"\n","\n","    for attempt in range(1, MAX_RETRIES + 1):\n","\n","        try:\n","            print(f\"Attempt {attempt}.